# Portas publicadas no host somente em desenvolvimento local.
# O Coolify usa docker-compose.yml sem docker-compose.override.yml, entao
# o proxy acessa as portas internas dos containers sem publicar no host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=3306

# Portas internas dos containers.
# Normalmente so altere se a plataforma exigir.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# URLs usadas entre navegador, frontend e backend.
# Dominio publico do frontend no Coolify; a API usa /api no mesmo dominio.
FRONTEND_URL=http://watercontrol.10.189.87.231.sslip.io
NEXT_PUBLIC_API_URL=/api

# Banco de dados.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=DB_water_control
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

DB_HOST=database
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=DB_water_control

# SessÃ£o de login (use uma chave aleatÃ³ria longa fora do ambiente local).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# SMS recovery via Twilio Verify; expose these in the backend runtime environment.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
PASSWORD_RESET_TTL_MINUTES=5

# Mailtrap Email API (token somente no backend; nunca use NEXT_PUBLIC_).
MAILTRAP_API_KEY=replace-with-your-mailtrap-api-token
MAILTRAP_USE_SANDBOX=true
MAILTRAP_SANDBOX_ID=replace-with-your-sandbox-id
MAIL_FROM_EMAIL=hello@demomailtrap.co
MAIL_FROM_NAME=WAPI
